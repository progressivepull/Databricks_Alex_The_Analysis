   "source": [
    "-- Average daily temperature by city, sorted from hottest to coldest\n",
    "SELECT \n",
    "  city_name, \n",
    "  AVG(temperature_avg) AS average_temperature \n",
    "FROM samples.accuweather.forecast_daily_calendar_imperial \n",
    "GROUP BY city_name \n",
    "ORDER BY average_temperature \n",
    "DESC;"
   ]
